{
  "mcpServers": {
    "container": {
      "command": "${CLAUDE_PLUGIN_ROOT}/server/container-mcp",
      "args": [
        "--write-tools-enabled",
        "${user_config.write_tools_enabled}",
        "--read-only-folders",
        "${user_config.read_only_folders}",
        "--writable-folders",
        "${user_config.writable_folders}",
        "--host-port-min",
        "${user_config.host_port_min}",
        "--host-port-max",
        "${user_config.host_port_max}",
        "--registries",
        "${user_config.registries}",
        "--default-cpus",
        "${user_config.default_cpus}",
        "--max-cpus",
        "${user_config.max_cpus}",
        "--default-memory-mib",
        "${user_config.default_memory_mib}",
        "--max-memory-mib",
        "${user_config.max_memory_mib}",
        "--log-max-lines",
        "${user_config.log_max_lines}",
        "--log-max-bytes",
        "${user_config.log_max_bytes}",
        "--exec-timeout-seconds",
        "${user_config.exec_timeout_seconds}",
        "--exec-max-output-bytes",
        "${user_config.exec_max_output_bytes}",
        "--pull-timeout-seconds",
        "${user_config.pull_timeout_seconds}",
        "--build-timeout-seconds",
        "${user_config.build_timeout_seconds}",
        "--adopted-containers",
        "${user_config.adopted_containers}"
      ]
    }
  }
}
